# Copy this file to .env and fill in what you need. It is loaded automatically.
# For production (DJANGO_DEBUG=0) the system refuses to start unless both of these are set to private values:
# DJANGO_SECRET_KEY=<long random string>
# DJANGO_DEBUG=0
FIXIT_IOT_API_KEY=change-this-demo-key

# --- Real email (password-reset links and landlord alerts) ---
# Leave EMAIL_HOST_USER empty to keep printing emails in the server window (development).
# Example for Gmail: turn on 2-step verification, create an "App password", then:
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Password-reset link lifetime in seconds (default 3600 = 1 hour)
FIXIT_RESET_TIMEOUT_SECONDS=3600
